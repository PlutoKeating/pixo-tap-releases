// 由 tools/publish-edge.mjs 自动生成，请勿手工编辑。
// d1_databases[0].database_id 为占位符（或维护者给出的 id）：D1 数据库、可选 KV（CACHE）与 Secret 在 Cloudflare 控制台配置。
// Secret 名称：PASSWORD_PEPPER、JWT_PRIVATE_KEY、CODE_HMAC_KEY、CSRF_KEY、LOG_HMAC_KEY、OUTBOX_KEY、SMTP_PASS（只在控制台或 wrangler secret put 中设置）。
// 见主仓库 docs/CLOUDFLARE_SETUP.md。
{
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "pixotap",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/healthz",
      "/readyz",
      "/.well-known/jwks.json",
      "/account/*",
      "/admin/*",
      "/install",
      "/install.ps1",
      "/install-mac"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixotap-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_IP",
      "namespace_id": "770001",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "RL_USER",
      "namespace_id": "770002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE_CODE",
      "namespace_id": "770003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE_TOKEN",
      "namespace_id": "770004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production",
    "TRUST_PROXY": "true",
    "AUTH_ISSUER": "https://pixotap.plutokeating.beer",
    "AUTH_AUDIENCE": "pixotap-api",
    "SITE_ORIGIN": "https://pixotap.plutokeating.beer",
    "MIN_AGE": "14",
    "SMTP_HOST": "smtp.yeah.net",
    "SMTP_PORT": "465",
    "SMTP_USER": "pixotap@yeah.net",
    "MAIL_FROM": "pixotap@yeah.net",
    "RELEASES_REPO": "PlutoKeating/pixo-tap-releases"
  }
}
