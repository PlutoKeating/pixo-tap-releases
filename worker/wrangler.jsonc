// 由 tools/publish-edge.mjs 自动生成，请勿手工编辑。
// hyperdrive.id 为占位符：Hyperdrive 绑定、可选 KV（CACHE）、变量与 Secret 在 Cloudflare 控制台配置。
// 见主仓库 docs/CLOUDFLARE_SETUP.md。
{
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "pixotap",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/healthz",
      "/readyz",
      "/account/*"
    ]
  },
  "ratelimits": [
    {
      "name": "RL_IP",
      "namespace_id": "770001",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "RL_USER",
      "namespace_id": "770002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE_CODE",
      "namespace_id": "770003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE_TOKEN",
      "namespace_id": "770004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production"
  }
}
